  "parameters": {
    "itemIds": "IDs of the asset items (at most 1000). Items of other owners, or that are not assembled, are rejected.",
    "contactIds": "IDs of the characters, corporations or alliances (at most 100).",
    "squadId": "ID of the squad to put the character in, or 0 for none. Which roles need it is set out under <c>role</c>.",
    "wingId": "ID of the wing to put the character in, or 0 for none. Which roles need it is set out under <c>role</c>.",
    "isRead": "Whether to mark the mail read (true) or unread (false). Leave null to keep it as it is."
  },

  "operations": {
    "GET /characters/{character_id}/search": {
      "params": {
        "isStrict": "Only return exact matches of <c>search</c> when true; otherwise also match names that start with it.",
        "language": "The language <c>search</c> is in, e.g. <c>en</c>, <c>de</c>, <c>fr</c>, <c>ja</c>, <c>ru</c>, <c>zh</c>, <c>ko</c>, <c>es</c>."
      }
    },
    "GET /dogma/dynamic/items/{type_id}/{item_id}": {
      "params": {
        "typeId": "Type ID of the mutated (abyssal) item.",
        "itemId": "Item ID of the mutated item."
      }
    },
    "POST /characters/affiliation": {
      "params": { "characterIds": "IDs of the characters to look up (at most 1000)." }
    },
    "POST /characters/{character_id}/fittings": {
      "params": { "fitting": "The fitting to save: its name, description, ship type ID and items (see <see cref=\"ESI.NET.Models.Fittings.Fitting\"/>)." }
    },
    "POST /characters/{character_id}/mail": {
      "params": {
        "recipients": "Who to send the mail to (at most 50), each with its ID and type: characters, plus at most one corporation, alliance or mailing list.",
        "subject": "The mail's subject (at most 1000 characters).",
        "body": "The mail's body (at most 10000 characters). EVE client markup is allowed.",
        "approvedCost": "The CSPA charge (ISK) you agree to pay to mail recipients who charge for unsolicited mail; get it from <see cref=\"ESI.NET.Logic.CharacterLogic.CSPA\"/>. 0 if none."
      }
    },
    "POST /characters/{character_id}/mail/labels": {
      "params": { "name": "The new label's name (at most 40 characters)." }
    },
    "POST /route/{origin_system_id}/{destination_system_id}": {
      "params": { "flag": "Which route to prefer: <see cref=\"ESI.NET.Enumerations.RoutePreference.Shorter\"/>, <see cref=\"ESI.NET.Enumerations.RoutePreference.Safer\"/> (avoids low and null sec), or <see cref=\"ESI.NET.Enumerations.RoutePreference.LessSecure\"/> (prefers them)." }
    },
    "POST /ui/openwindow/newmail": {
      "params": {
        "recipients": "Character IDs to fill in as recipients.",
        "subject": "The subject to fill in.",
        "body": "The body to fill in."
      }
    },
    "POST /universe/ids": {
      "params": { "names": "Names to resolve (at most 500). Only exact matches are returned, in categories such as characters, corporations, alliances, systems, stations and item types." }
    },
    "POST /universe/names": {
      "params": { "anyIds": "IDs of any kind (characters, corporations, alliances, stations, systems, regions, constellations, types, factions) to resolve to names (at most 1000)." }
    },
    "PUT /characters/{character_id}/calendar/{event_id}": {
